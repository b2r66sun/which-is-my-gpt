{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "knows": {
            "type": "integer",
            "enum": [0, 1]
          },
          "what": {
            "type": "string"
          }
        },
        "required": ["no", "knows", "what"],
        "additionalProperties": false
      }
    }
  },
  "required": ["answers"],
  "additionalProperties": false
}
